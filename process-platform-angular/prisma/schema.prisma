generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MODELER
  AUDITOR
  VIEWER
}

enum ProcessNodeType {
  GROUP
  PROCESS
}

enum ProcessStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Rola pracovneho miesta v zodpovednosti za proces (#15).
/// Zodpovednost je naviazana na MIESTO, nie na cloveka — po zmene obsadenia
/// sa automaticky zobrazi novy clovek.
enum ResponsibilityRole {
  /// vlastnik procesu — zodpoveda za jeho obsah a zmeny
  OWNER
  /// vykonavatel — proces realizuje
  PERFORMER
}

/// Stav verzie popisu prace (#16).
enum JobDescriptionStatus {
  DRAFT
  PUBLISHED
}

/// Typ jednorazoveho tokenu (#20).
enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Stav odchadzajuceho emailu (#20).
enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum AttachmentKind {
  DOCUMENT
  IMAGE
  EXPORT
  OTHER
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  defaultLocale      String               @default("sk")
  camundaBaseUrl     String?
  camundaDeploymentKey String?
  autoTranslate           Boolean  @default(false)
  translationProvider     String?
  translationApiKeyEnc    String?
  translationTargetLocale String?
  /// Kapacita uloziska v MB (#9). Hlavny kapacitny parameter planu — nie pocet procesov.
  storageQuotaMb     Int                  @default(1024)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  users              OrganizationUser[]
  roles              Role[]
  invitations        Invitation[]
  processNodes       ProcessNode[]
  attachments        Attachment[]
  translations       Translation[]
  isoTemplates       IsoTemplate[]
  approvalRequests   ApprovalRequest[]
  camundaDeployments CamundaDeployment[]
  positions          OrgPosition[]
  units              OrgUnit[]
  sessions           Session[]
  persons            Person[]
  assignments        PositionAssignment[]
  jobProfiles        JobProfile[]
  jobDescriptions    JobDescriptionVersion[]
}

/// Prihlasovacia relacia. V DB je len hash tokenu — unik databazy tak
/// neumoznuje prevziat cudziu relaciu.
model Session {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  name           String
  passwordHash   String
  /// #20 — kedy pouzivatel potvrdil email; null = neovereny
  emailVerifiedAt DateTime?
  locale         String             @default("sk")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organizations  OrganizationUser[]
  ownedProcesses ProcessNode[]      @relation("ProcessOwner")
  revisions      ProcessRevision[]
  approvals      ApprovalRequest[]  @relation("ApprovalRequestedBy")
  approvalSteps  ApprovalStep[]     @relation("ApprovalStepAssignee")
  attachments    Attachment[]       @relation("AttachmentUploader")
  persons        Person[]
  jobDescriptions JobDescriptionVersion[]
  authTokens     AuthToken[]
  sessions       Session[]
  processChanges ProcessChangeLog[]
}

model OrganizationUser {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  roleId         String?
  isOwner        Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole     Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  description    String?
  permissions    String[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          OrganizationUser[]
  invitations    Invitation[]

  @@unique([organizationId, name])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  token          String           @unique
  role           OrganizationRole @default(VIEWER)
  roleId         String?
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole     Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model ProcessNode {
  id                 String              @id @default(uuid())
  organizationId     String
  parentId           String?
  ownerId            String?
  type               ProcessNodeType
  name               String
  description        String?
  descriptionText    String?
  status             ProcessStatus       @default(DRAFT)
  sortOrder          Int                 @default(0)
  bpmnXml            String?
  diagramType        String              @default("NONE")
  flowchartXml       String?
  isoLinks           String[]
  relatedProcessIds  String[]
  isoSuggestions     Json?
  translations       Json?
  camundaProcessKey  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent             ProcessNode?        @relation("ProcessTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           ProcessNode[]       @relation("ProcessTree")
  owner              User?               @relation("ProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  revisions          ProcessRevision[]
  attachments        Attachment[]
  approvalRequests   ApprovalRequest[]
  camundaDeployments CamundaDeployment[]
  positions          ProcessPosition[]
  changeLogs         ProcessChangeLog[]

  @@index([organizationId, parentId, sortOrder])
}

model ProcessRevision {
  id              String      @id @default(uuid())
  processNodeId   String
  authorId        String?
  name            String
  note            String?
  bpmnXml         String
  diagramSvg      String?
  documentation   Json?
  createdAt       DateTime    @default(now())

  processNode     ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  author          User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([processNodeId, createdAt])
}

model Attachment {
  id             String         @id @default(uuid())
  organizationId String
  processNodeId  String?
  uploadedById   String?
  kind           AttachmentKind @default(DOCUMENT)
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode?   @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  uploadedBy     User?          @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  positions      AttachmentPosition[]

  @@index([organizationId, processNodeId])
}

model ApprovalRequest {
  id             String         @id @default(uuid())
  organizationId String
  processNodeId  String
  requestedById  String?
  title          String
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode    @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  requestedBy    User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  steps          ApprovalStep[]
}

model ApprovalStep {
  id                String          @id @default(uuid())
  approvalRequestId String
  assigneeId        String?
  order             Int             @default(0)
  status            ApprovalStatus  @default(PENDING)
  comment           String?
  decidedAt         DateTime?

  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  assignee          User?           @relation("ApprovalStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model IsoTemplate {
  id             String       @id @default(uuid())
  organizationId String?
  standard       String
  clause         String       @default("")
  title          String       @default("")
  description    String?
  controls       Json?
  name           String?
  version        String?
  language       String?
  sourcePdfUrl   String?
  structure      Json?
  createdAt      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, standard, clause])
}

model Translation {
  id             String        @id @default(uuid())
  organizationId String?
  locale         String
  key            String
  value          String
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locale, key])
  @@index([locale, key])
}

model OrgUnit {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// Nadradena jednotka (#12). Strom bez cyklov — kontroluje API pri zmene.
  parentId       String?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         OrgUnit?      @relation("UnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrgUnit[]     @relation("UnitTree")
  positions      OrgPosition[]

  @@unique([organizationId, name])
  @@index([parentId])
}

model OrgPosition {
  id             String       @id @default(uuid())
  organizationId String
  unitId         String?
  name           String
  description    String?
  /// Nadriadene pracovne miesto (#12) — komu miesto podlieha.
  reportsToId    String?
  /// Profil prace, ktory miesto napla (#16)
  jobProfileId   String?
  createdAt      DateTime     @default(now())

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit           OrgUnit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  reportsTo      OrgPosition?         @relation("PositionReports", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates   OrgPosition[]        @relation("PositionReports")
  jobProfile     JobProfile?          @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  assignments    PositionAssignment[]
  processes      ProcessPosition[]
  documents      AttachmentPosition[]

  @@unique([organizationId, name])
}

model AttachmentPosition {
  id           String      @id @default(uuid())
  attachmentId String
  positionId   String

  attachment   Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  position     OrgPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, positionId])
}

/// Profil prace (#16) — znovupouzitelny opis typu prace (napr. uctovnik),
/// na ktory sa odkazuje viac konkretnych pracovnych miest.
model JobProfile {
  id             String                  @id @default(uuid())
  organizationId String
  name           String
  summary        String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  positions      OrgPosition[]
  versions       JobDescriptionVersion[]

  @@unique([organizationId, name])
}

/// Verzia popisu prace (#16). Publikovana verzia sa uz nemeni — zmena je nova
/// verzia. Platna je publikovana verzia s najneskorsim effectiveFrom <= dnes.
model JobDescriptionVersion {
  id             String               @id @default(uuid())
  organizationId String
  jobProfileId   String
  version        Int
  status         JobDescriptionStatus @default(DRAFT)
  content        String               @default("")
  authorId       String?
  effectiveFrom  DateTime?            @db.Date
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobProfile     JobProfile           @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
  author         User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([jobProfileId, version])
}

/// Osoba v pracovnom adresari (#13). Nemusi mat pouzivatelsky ucet — taka sa
/// nepocita ako plateny pouzivatel. Ak ucet ma, je prepojena cez userId.
model Person {
  id             String               @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  email          String?
  phone          String?
  note           String?
  /// false = osoba z firmy odisla; zaznam ostava kvoli historii obsadeni
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments    PositionAssignment[]

  @@unique([organizationId, userId])
  @@index([organizationId, active])
}

/// Obsadenie pracovneho miesta osobou na obdobie (#14). validTo = null znamena
/// aktivne obsadenie, validTo je posledny den (vratane). Ukoncenie zaznam
/// nemaze — historia, kto miesto kedy zastaval, ostava.
model PositionAssignment {
  id             String       @id @default(uuid())
  organizationId String
  positionId     String
  personId       String
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position       OrgPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([positionId, validTo])
  @@index([personId])
}


model ProcessPosition {
  id            String      @id @default(uuid())
  processNodeId String
  positionId    String
  role          ResponsibilityRole @default(PERFORMER)

  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  position      OrgPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([processNodeId, positionId, role])
}

model ProcessChangeLog {
  id            String      @id @default(uuid())
  processNodeId String
  userId        String?
  changedFields Json
  description   String?
  createdAt     DateTime    @default(now())

  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([processNodeId, createdAt])
}

/// Audit zasahov operatora v backoffice (#18). Zapisuje sa kto, co a na com —
/// nikdy nie obsah zakaznika (procesy, dokumenty, osoby).
/// Jednorazovy token na overenie emailu a reset hesla (#20). V DB je len hash —
/// unik databazy neumozni pouzit cudzi odkaz.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Odchadzajuce emaily (#20). Kym nie je nastaveny poskytovatel (SMTP), zostavaju
/// vo fronte; po odoslani sa telo maze (obsahuje jednorazove odkazy).
model EmailOutbox {
  id        String      @id @default(uuid())
  toAddress String
  template  String
  subject   String
  bodyText  String
  status    EmailStatus @default(QUEUED)
  error     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

model BackofficeAuditLog {
  id            String   @id @default(uuid())
  adminId       String?
  adminUsername String
  action        String
  targetType    String?
  targetId      String?
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model BackofficeAdmin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model CamundaDeployment {
  id             String       @id @default(uuid())
  organizationId String
  processNodeId  String
  deploymentId   String
  processKey     String
  deployedAt     DateTime     @default(now())
  response        Json?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode  @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
}
