generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MODELER
  AUDITOR
  VIEWER
}

enum ProcessNodeType {
  GROUP
  PROCESS
}

enum ProcessStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  /// #37 — ziadatel ziadost stiahol
  WITHDRAWN
}

/// Rola pracovneho miesta v zodpovednosti za proces (#15).
/// Zodpovednost je naviazana na MIESTO, nie na cloveka — po zmene obsadenia
/// sa automaticky zobrazi novy clovek.
enum ResponsibilityRole {
  /// vlastnik procesu — zodpoveda za jeho obsah a zmeny
  OWNER
  /// vykonavatel — proces realizuje
  PERFORMER
}

/// Stav verzie popisu prace (#16).
enum JobDescriptionStatus {
  DRAFT
  PUBLISHED
}

/// Typ jednorazoveho tokenu (#20).
enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Stav odchadzajuceho emailu (#20).
enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum AttachmentKind {
  DOCUMENT
  IMAGE
  EXPORT
  OTHER
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  defaultLocale      String               @default("sk")
  camundaBaseUrl     String?
  camundaDeploymentKey String?
  autoTranslate           Boolean  @default(false)
  translationProvider     String?
  translationApiKeyEnc    String?
  translationTargetLocale String?
  /// Kapacita uloziska v MB (#9). Hlavny kapacitny parameter planu — nie pocet procesov.
  storageQuotaMb     Int                  @default(1024)
  /// #37 — true = verziu procesu mozno zverejnit len schvalenim (nie priamym publikovanim)
  requireApproval    Boolean              @default(false)
  /// #40 — profil „Kvalita a audit“: kontrolne otazky a pripravenost evidencie
  qualityProfile     Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  users              OrganizationUser[]
  roles              Role[]
  invitations        Invitation[]
  processNodes       ProcessNode[]
  attachments        Attachment[]
  translations       Translation[]
  isoTemplates       IsoTemplate[]
  approvalRequests   ApprovalRequest[]
  camundaDeployments CamundaDeployment[]
  positions          OrgPosition[]
  units              OrgUnit[]
  sessions           Session[]
  persons            Person[]
  assignments        PositionAssignment[]
  jobProfiles        JobProfile[]
  jobDescriptions    JobDescriptionVersion[]
  processVersions    ProcessVersion[]
  domainEvents       DomainEvent[]
  notifications      Notification[]
  controlledDocuments ControlledDocument[]
  evidenceRecords    EvidenceRecord[]
  itSystems          ItSystem[]
}

/// Prihlasovacia relacia. V DB je len hash tokenu — unik databazy tak
/// neumoznuje prevziat cudziu relaciu.
model Session {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  name           String
  passwordHash   String
  /// #20 — kedy pouzivatel potvrdil email; null = neovereny
  emailVerifiedAt DateTime?
  locale         String             @default("sk")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organizations  OrganizationUser[]
  ownedProcesses ProcessNode[]      @relation("ProcessOwner")
  revisions      ProcessRevision[]
  approvals      ApprovalRequest[]  @relation("ApprovalRequestedBy")
  approvalSteps  ApprovalStep[]     @relation("ApprovalStepAssignee")
  attachments    Attachment[]       @relation("AttachmentUploader")
  persons        Person[]
  jobDescriptions JobDescriptionVersion[]
  authTokens     AuthToken[]
  publishedVersions ProcessVersion[] @relation("ProcessVersionPublisher")
  approvedVersions  ProcessVersion[] @relation("ProcessVersionApprover")
  authoredFeedback  ProcessFeedback[] @relation("FeedbackAuthor")
  decidedFeedback   ProcessFeedback[] @relation("FeedbackDecider")
  notifications     Notification[]
  evidenceRecords   EvidenceRecord[]    @relation("EvidenceAuthor")
  readinessMarked   ReadinessException[] @relation("ExceptionMarker")
  readinessApproved ReadinessException[] @relation("ExceptionApprover")
  sessions       Session[]
  processChanges ProcessChangeLog[]
}

model OrganizationUser {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  roleId         String?
  isOwner        Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole     Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  description    String?
  permissions    String[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          OrganizationUser[]
  invitations    Invitation[]

  @@unique([organizationId, name])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  token          String           @unique
  role           OrganizationRole @default(VIEWER)
  roleId         String?
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole     Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model ProcessNode {
  id                 String              @id @default(uuid())
  organizationId     String
  parentId           String?
  ownerId            String?
  type               ProcessNodeType
  name               String
  /// #30 — kod procesu (napr. PR-07), velkymi pismenami, jedinecny vo firme
  code               String?
  description        String?
  descriptionText    String?
  /// #28 — kedy sa proces spusti (napr. „prisla faktura“)
  trigger            String?
  /// #28 — co je vysledkom (napr. „uhradena alebo vratena faktura“)
  outcome            String?
  status             ProcessStatus       @default(DRAFT)
  sortOrder          Int                 @default(0)
  bpmnXml            String?
  diagramType        String              @default("NONE")
  flowchartXml       String?
  isoLinks           String[]
  relatedProcessIds  String[]
  /// #40 QUAL-01 — riadeny proces: vstupy, vystupy a nadvaznost na ine procesy
  inputs             String[]
  outputs            String[]
  upstreamProcessIds   String[]
  downstreamProcessIds String[]
  /// profil Kvalita a audit: meradlo uspechu, zdroje, rizika, prilezitosti, co sa uchovava ako zaznam
  successMeasure     String?
  resources          String?
  risks              String?
  opportunities      String?
  evidenceRequirements String[]
  /// #43 — IT systemy, ktore proces pouziva (ID ItSystem vlastnej firmy)
  systemIds          String[]
  isoSuggestions     Json?
  translations       Json?
  camundaProcessKey  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent             ProcessNode?        @relation("ProcessTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           ProcessNode[]       @relation("ProcessTree")
  owner              User?               @relation("ProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  revisions          ProcessRevision[]
  attachments        Attachment[]
  approvalRequests   ApprovalRequest[]
  camundaDeployments CamundaDeployment[]
  positions          ProcessPosition[]
  changeLogs         ProcessChangeLog[]
  versions           ProcessVersion[]
  feedback           ProcessFeedback[]
  controlledDocuments ControlledDocument[]
  evidenceRecords    EvidenceRecord[]
  readinessExceptions ReadinessException[]
  activities         ProcessActivity[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId, sortOrder])
}

/// Krok procesu v navrhu (#28 CORE-02). Na zaciatok staci linearny zoznam;
/// v publikovanej verzii je kopia v snapshote, tabulka drzi len navrh.
model ProcessActivity {
  id             String      @id @default(uuid())
  organizationId String
  processNodeId  String
  sortOrder      Int
  title          String
  description    String?
  /// #43 — IT systemy pouzite pri kroku
  systemIds      String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  processNode    ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  responsibilities ActivityResponsibility[]
  feedback         ProcessFeedback[]

  @@index([processNodeId, sortOrder])
}

/// #29 CORE-03 — RACI na kroku: R vykonava, A zodpoveda, C konzultuje, I je informovany.
enum RaciRole {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

/// Zodpovednost pri kroku patri pracovnemu miestu — kto ho zastava, sa odvodzuje
/// z obsadenia v case. Konkretna osoba len vynimkou (napr. externy poradca);
/// prave jedno z positionId / personId strazi CHECK v migracii.
model ActivityResponsibility {
  id             String          @id @default(uuid())
  organizationId String
  activityId     String
  role           RaciRole
  positionId     String?
  personId       String?
  createdAt      DateTime        @default(now())

  activity       ProcessActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  position       OrgPosition?    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  person         Person?         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([positionId])
  @@index([personId])
}

/// Publikovana verzia procesu (#27 CORE-01). Snapshot sa uz nemeni — dalsia
/// uprava procesu je navrh (ProcessNode) a az publikovanim vznikne nova verzia.
/// ID procesu ostava rovnake, cita sa verzia ucinna v danom dni.
model ProcessVersion {
  id             String       @id @default(uuid())
  organizationId String
  processNodeId  String
  revision       Int
  /// obsah v case publikovania — texty, diagram, zodpovednosti (ID miest, nie mena),
  /// dokumenty (ID priloh); meno drzitela sa odvodzuje z obsadenia v case
  snapshot       Json
  /// odtlacok obsahu — ci ma navrh zmeny oproti tejto verzii
  contentHash    String
  changeReason   String?
  effectiveFrom  DateTime     @db.Date
  /// posledny den platnosti (vratane); null = plati, kym ju nenahradi dalsia verzia
  effectiveTo    DateTime?    @db.Date
  nextReviewAt   DateTime?    @db.Date
  publishedById  String?
  publishedAt    DateTime     @default(now())
  /// #37 — kto verziu schvalil (pri priamom publikovani prazdne)
  approvedById   String?
  approvedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode  @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  publishedBy    User?        @relation("ProcessVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  approvedBy     User?        @relation("ProcessVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  feedback       ProcessFeedback[]

  @@unique([processNodeId, revision])
  @@index([processNodeId, effectiveFrom])
}

model ProcessRevision {
  id              String      @id @default(uuid())
  processNodeId   String
  authorId        String?
  name            String
  note            String?
  bpmnXml         String
  diagramSvg      String?
  documentation   Json?
  createdAt       DateTime    @default(now())

  processNode     ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  author          User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([processNodeId, createdAt])
}

model Attachment {
  id             String         @id @default(uuid())
  organizationId String
  processNodeId  String?
  uploadedById   String?
  kind           AttachmentKind @default(DOCUMENT)
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode?   @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  uploadedBy     User?          @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  positions      AttachmentPosition[]
  /// #31 DOC-02 — verzia riadeneho dokumentu (subor = jedna verzia)
  documentId     String?
  version        Int            @default(1)
  /// odkedy verzia plati (den); nova verzia moze byt naplanovana dopredu
  effectiveFrom  DateTime?      @db.Date
  changeNote     String?
  document       ControlledDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([organizationId, processNodeId])
}

model ApprovalRequest {
  id             String         @id @default(uuid())
  organizationId String
  processNodeId  String
  requestedById  String?
  title          String
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?
  /// #37 — obsah zmrazeny pri odoslani: schvaluje sa presne to, co schvalovatel videl
  snapshot       Json?
  contentHash    String?
  effectiveFrom  DateTime?      @db.Date
  nextReviewAt   DateTime?      @db.Date
  changeReason   String?
  /// verzia, ktora vznikla schvalenim
  versionId      String?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode    @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  requestedBy    User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  steps          ApprovalStep[]

  @@index([organizationId, status])
}

model ApprovalStep {
  id                String          @id @default(uuid())
  approvalRequestId String
  assigneeId        String?
  order             Int             @default(0)
  status            ApprovalStatus  @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  /// #37 — miesta, ktore rozhodujuci v den rozhodnutia zastaval (historicky zaznam)
  deciderPositions  String?

  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  assignee          User?           @relation("ApprovalStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model IsoTemplate {
  id             String       @id @default(uuid())
  organizationId String?
  standard       String
  clause         String       @default("")
  title          String       @default("")
  description    String?
  controls       Json?
  name           String?
  version        String?
  language       String?
  sourcePdfUrl   String?
  structure      Json?
  createdAt      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, standard, clause])
}

model Translation {
  id             String        @id @default(uuid())
  organizationId String?
  locale         String
  key            String
  value          String
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locale, key])
  @@index([locale, key])
}

model OrgUnit {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// Nadradena jednotka (#12). Strom bez cyklov — kontroluje API pri zmene.
  parentId       String?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         OrgUnit?      @relation("UnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrgUnit[]     @relation("UnitTree")
  positions      OrgPosition[]

  @@unique([organizationId, name])
  @@index([parentId])
}

model OrgPosition {
  id             String       @id @default(uuid())
  organizationId String
  unitId         String?
  name           String
  description    String?
  /// Nadriadene pracovne miesto (#12) — komu miesto podlieha.
  reportsToId    String?
  /// Profil prace, ktory miesto napla (#16)
  jobProfileId   String?
  /// #43 GRAPH-01 — archivovane miesto: nikto ho nezastava a nove vazby nedostava;
  /// existujuce vazby a historia ostavaju (vlastnik procesu sa ticho nestrati)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit           OrgUnit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  reportsTo      OrgPosition?         @relation("PositionReports", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates   OrgPosition[]        @relation("PositionReports")
  jobProfile     JobProfile?          @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  assignments    PositionAssignment[]
  processes      ProcessPosition[]
  activityResponsibilities ActivityResponsibility[]
  ownedDocuments  ControlledDocument[]
  ownedSystems   ItSystem[]
  documents      AttachmentPosition[]

  @@unique([organizationId, name])
}

model AttachmentPosition {
  id           String      @id @default(uuid())
  attachmentId String
  positionId   String

  attachment   Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  position     OrgPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, positionId])
}

/// Profil prace (#16) — znovupouzitelny opis typu prace (napr. uctovnik),
/// na ktory sa odkazuje viac konkretnych pracovnych miest.
model JobProfile {
  id             String                  @id @default(uuid())
  organizationId String
  name           String
  summary        String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  positions      OrgPosition[]
  versions       JobDescriptionVersion[]

  @@unique([organizationId, name])
}

/// Verzia popisu prace (#16). Publikovana verzia sa uz nemeni — zmena je nova
/// verzia. Platna je publikovana verzia s najneskorsim effectiveFrom <= dnes.
model JobDescriptionVersion {
  id             String               @id @default(uuid())
  organizationId String
  jobProfileId   String
  version        Int
  status         JobDescriptionStatus @default(DRAFT)
  content        String               @default("")
  authorId       String?
  effectiveFrom  DateTime?            @db.Date
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobProfile     JobProfile           @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
  author         User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([jobProfileId, version])
}

/// Osoba v pracovnom adresari (#13). Nemusi mat pouzivatelsky ucet — taka sa
/// nepocita ako plateny pouzivatel. Ak ucet ma, je prepojena cez userId.
model Person {
  id             String               @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  email          String?
  phone          String?
  note           String?
  /// false = osoba z firmy odisla; zaznam ostava kvoli historii obsadeni
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments    PositionAssignment[]
  activityResponsibilities ActivityResponsibility[]

  @@unique([organizationId, userId])
  @@index([organizationId, active])
}

/// Obsadenie pracovneho miesta osobou na obdobie (#14). validTo = null znamena
/// aktivne obsadenie, validTo je posledny den (vratane). Ukoncenie zaznam
/// nemaze — historia, kto miesto kedy zastaval, ostava.
model PositionAssignment {
  id             String       @id @default(uuid())
  organizationId String
  positionId     String
  personId       String
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position       OrgPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([positionId, validTo])
  @@index([personId])
}


model ProcessPosition {
  id            String      @id @default(uuid())
  processNodeId String
  positionId    String
  role          ResponsibilityRole @default(PERFORMER)

  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  position      OrgPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([processNodeId, positionId, role])
}

model ProcessChangeLog {
  id            String      @id @default(uuid())
  processNodeId String
  userId        String?
  changedFields Json
  description   String?
  createdAt     DateTime    @default(now())

  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([processNodeId, createdAt])
}

/// Audit zasahov operatora v backoffice (#18). Zapisuje sa kto, co a na com —
/// nikdy nie obsah zakaznika (procesy, dokumenty, osoby).
/// Jednorazovy token na overenie emailu a reset hesla (#20). V DB je len hash —
/// unik databazy neumozni pouzit cudzi odkaz.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Odchadzajuce emaily (#20). Kym nie je nastaveny poskytovatel (SMTP), zostavaju
/// vo fronte; po odoslani sa telo maze (obsahuje jednorazove odkazy).
model EmailOutbox {
  id        String      @id @default(uuid())
  toAddress String
  template  String
  subject   String
  bodyText  String
  status    EmailStatus @default(QUEUED)
  error     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

model BackofficeAuditLog {
  id            String   @id @default(uuid())
  adminId       String?
  adminUsername String
  action        String
  targetType    String?
  targetId      String?
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model BackofficeAdmin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model CamundaDeployment {
  id             String       @id @default(uuid())
  organizationId String
  processNodeId  String
  deploymentId   String
  processKey     String
  deployedAt     DateTime     @default(now())
  response        Json?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode  @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
}

/// #36 UX-01d — podnet k procesu od hocikoho vo firme: chyba v postupe alebo navrh zlepsenia.
enum FeedbackKind {
  ERROR
  IMPROVEMENT
}

/// OPEN → ACCEPTED (zapracuje sa) → DONE; alebo REJECTED s dovodom.
enum FeedbackStatus {
  OPEN
  ACCEPTED
  REJECTED
  DONE
}

/// Vlastnik procesu (kto dnes zastava jeho miesto) alebo editor podnet vybavi;
/// autor vidi svoje podnety a ich vysledok.
model ProcessFeedback {
  id             String          @id @default(uuid())
  organizationId String
  processNodeId  String
  /// verzia, ktoru autor cital (null = proces este nebol publikovany)
  versionId      String?
  /// krok, ktoreho sa podnet tyka; nazov sa pamata aj po zmazani kroku
  activityId     String?
  stepTitle      String?
  kind           FeedbackKind
  text           String
  status         FeedbackStatus  @default(OPEN)
  authorId       String?
  decisionNote   String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())

  processNode    ProcessNode     @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  version        ProcessVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  activity       ProcessActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  author         User?           @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  decidedBy      User?           @relation("FeedbackDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([processNodeId, createdAt])
}

/// #38 GOV-02 — domenova udalost (outbox). Zapisuje sa spolu so zmenou; upozornenia
/// z nej vyrobi dispecer. E-mail sa doplni z tej istej udalosti po #20.
model DomainEvent {
  id             String         @id @default(uuid())
  organizationId String
  /// ProcessPublished, ReviewDue, PositionAssignmentChanged, ApprovalRequested,
  /// ApprovalDecided, FeedbackSubmitted, FeedbackDecided
  type           String
  processNodeId  String?
  actorId        String?
  payload        Json
  /// proti duplicitam udalosti, ktore vznikaju opakovanym prehladanim (ReviewDue)
  dedupeKey      String?        @unique
  createdAt      DateTime       @default(now())
  processedAt    DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([processedAt, createdAt])
}

/// Upozornenie pre konkretneho pouzivatela v aplikacii.
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  eventId        String
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          DomainEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, readAt, createdAt])
}

/// #31 DOC-02 — stav riadeneho dokumentu; archivovany sa uz nenavrhuje k procesom.
enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

/// Riadeny dokument: nazov, vlastnik (pracovne miesto), stav. Subory su jeho verzie
/// (Attachment.documentId) — publikovana verzia procesu odkazuje na konkretnu verziu.
model ControlledDocument {
  id              String         @id @default(uuid())
  organizationId  String
  processNodeId   String?
  title           String
  ownerPositionId String?
  status          DocumentStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode     ProcessNode?   @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  ownerPosition   OrgPosition?   @relation(fields: [ownerPositionId], references: [id], onDelete: SetNull)
  versions        Attachment[]

  @@index([organizationId, processNodeId])
}

/// #40 QUAL-01 — zaznam o vykonani (dokaz): co sa urobilo, kedy, kto to zapisal.
/// Odlisuje sa od postupu — existujuci postup este neznamena, ze sa vykonal.
model EvidenceRecord {
  id             String        @id @default(uuid())
  organizationId String
  processNodeId  String
  /// ktoru poziadavku na zaznam (text z evidenceRequirements) dokladuje
  requirement    String
  /// den vykonania
  performedOn    DateTime      @db.Date
  note           String?
  /// volitelne odkaz na verziu dokumentu (priloha)
  attachmentId   String?
  createdById    String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processNode    ProcessNode   @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("EvidenceAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([processNodeId, requirement, performedOn])
}

/// #40 — polozka pripravenosti oznacena ako neaplikovatelna: s dovodom a schvalenim
/// inym clovekom (nie svojvolnym skrytim chyby).
model ReadinessException {
  id             String      @id @default(uuid())
  organizationId String
  processNodeId  String
  itemKey        String
  reason         String
  markedById     String?
  markedAt       DateTime    @default(now())
  approvedById   String?
  approvedAt     DateTime?

  processNode    ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  markedBy       User?       @relation("ExceptionMarker", fields: [markedById], references: [id], onDelete: SetNull)
  approvedBy     User?       @relation("ExceptionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([processNodeId, itemKey])
}

/// #43 GRAPH-01 — IT system (aplikacia, nastroj), ktory procesy a kroky pouzivaju.
/// Vazby su ID v ProcessNode.systemIds a ProcessActivity.systemIds (aj v snapshote verzie);
/// pouzity system sa nemaze, len archivuje — verzie si ho pamataju podla ID.
model ItSystem {
  id              String       @id @default(uuid())
  organizationId  String
  name            String
  /// skratka, napr. ERP
  code            String?
  description     String?
  vendor          String?
  /// odkaz na system alebo jeho dokumentaciu (len http/https)
  url             String?
  /// kto za system zodpoveda — pracovne miesto, nie osoba
  ownerPositionId String?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerPosition   OrgPosition? @relation(fields: [ownerPositionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
}
