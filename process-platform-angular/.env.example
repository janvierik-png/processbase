DATABASE_URL="postgresql://process_user:process_password@localhost:5432/process_platform?schema=public"
API_PORT="3000"
API_HOST="0.0.0.0"
CAMUNDA7_BASE_URL="http://localhost:8080/engine-rest"
CAMUNDA7_USERNAME=""
CAMUNDA7_PASSWORD=""

# --- Tajomstva (#19) ---
# Ak nie su nastavene, server ich pri prvom starte vygeneruje do SECRETS_FILE.
# Na produkcii ich nastavte (min. 32 znakov), napr.: openssl rand -base64 48
# Zmena SETTINGS_ENCRYPTION_KEY znemozni desifrovat ulozene API kluce (treba zadat znova),
# zmena BACKOFFICE_JWT_SECRET odhlasi vsetkych backoffice adminov.
SETTINGS_ENCRYPTION_KEY=""
BACKOFFICE_JWT_SECRET=""
SECRETS_FILE="storage/secrets.json"

# Prvy backoffice admin — vytvori sa len ak ziadny neexistuje.
# Bez hesla sa vygeneruje docasne do storage/initial-backoffice-password.txt.
BACKOFFICE_ADMIN_USERNAME="admin"
BACKOFFICE_ADMIN_PASSWORD=""

# --- Ulozisko a prevadzka ---
# Prilohy (#10) — zalohovat spolu s databazou a SECRETS_FILE.
UPLOAD_DIR="storage/uploads"
# Den pre obsadenia miest a ucinnost popisov prace (#14, #16).
APP_TIMEZONE="Europe/Bratislava"
# Od ktorych proxy sa veri hlavicke X-Forwarded-For (IP klienta pre limit prihlaseni).
TRUST_PROXY="loopback, linklocal, uniquelocal"

# --- E-maily (#20) ---
# Adresa aplikacie pre odkazy v e-mailoch (overenie, obnova hesla).
APP_URL="http://localhost:4200"
# "outbox" = e-maily len vo fronte v DB (kym nie je vybraty poskytovatel a DNS SPF/DKIM/DMARC).
MAIL_TRANSPORT="outbox"
# "true" = bez potvrdeneho e-mailu sa neda prihlasit — zapnut az ked sa e-maily skutocne dorucuju.
REQUIRE_EMAIL_VERIFICATION="false"

# --- AI asistent (#42, #41) ---
# Kľúč prevádzkovateľa pre Anthropic Claude. Bez neho AI funguje len s vlastným kľúčom firmy
# (Nastavenia → Integrácie); návrh z textu a import podľa pravidiel funguje vždy aj bez AI.
# Firma musí AI zapnúť sama — obsah sa posiela len na výslovnú akciu používateľa.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# najviac AI požiadaviek na firmu za hodinu
AI_HOURLY_LIMIT="30"
