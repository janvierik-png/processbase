# Produkcne premenne — skopirujte do deploy/.env (mimo gitu) a vyplnte.
# Nahodne hodnoty:  openssl rand -base64 48

POSTGRES_DB=processbase
POSTGRES_USER=processbase
POSTGRES_PASSWORD=

# Tajomstva (min. 32 znakov). Ak ostanu prazdne, vygeneruju sa do /data/secrets.json.
# Zmena SETTINGS_ENCRYPTION_KEY = ulozene API kluce treba zadat znova.
SETTINGS_ENCRYPTION_KEY=
BACKOFFICE_JWT_SECRET=

# Prvy backoffice admin (len ak ziadny neexistuje). Bez hesla sa vygeneruje
# do /data/initial-backoffice-password.txt.
BACKOFFICE_ADMIN_USERNAME=admin
BACKOFFICE_ADMIN_PASSWORD=

# Verejna adresa aplikacie — odkazy v e-mailoch.
APP_URL=https://processbase.klomproject.sk
APP_TIMEZONE=Europe/Bratislava

# Reverzna proxy bezi na hoste (nginx) — kontajner ju vidi z privatnej siete Dockeru.
TRUST_PROXY=loopback, linklocal, uniquelocal

# E-maily (#20): kym nie je poskytovatel, zostavaju vo fronte.
MAIL_TRANSPORT=outbox
REQUIRE_EMAIL_VERIFICATION=false
