# Reverzna proxy s TLS pred aplikaciou. Certifikat napr.: certbot --nginx -d processbase.klomproject.sk
# Backoffice (port 4300) sem zamerne NIE JE — pristup cez SSH tunel:
#   ssh -L 4300:127.0.0.1:4300 uzivatel@server   a potom http://localhost:4300

server {
    listen 80;
    server_name processbase.klomproject.sk;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name processbase.klomproject.sk;

    ssl_certificate     /etc/letsencrypt/live/processbase.klomproject.sk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/processbase.klomproject.sk/privkey.pem;

    # prilohy do 100 MB (server/index.ts MAX_UPLOAD_BYTES) + rezerva
    client_max_body_size 110m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # velke nahravanie sa posiela priebezne, nie cez docasny subor nginx
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
